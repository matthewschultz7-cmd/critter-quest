rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone authenticated (anonymously) can read/write their family
    match /families/{familyId} {
      allow read, write: if request.auth != null;

      match /profiles/{profileId} {
        allow read, write: if request.auth != null;
      }
    }

    // Feedback: anyone authenticated can submit, nobody can read via app
    match /feedback/{docId} {
      allow create: if request.auth != null;
    }

    // Top-level profile index — readable for leaderboard, writable for own records
    match /profiles/{profileId} {
      allow read, create, update: if request.auth != null;
    }

    // Player code lookup (for adding friends)
    match /playerCodes/{code} {
      allow read, create: if request.auth != null;
    }

    // Join code index — readable by anyone authenticated
    match /familyCodes/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
